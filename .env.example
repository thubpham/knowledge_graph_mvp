# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — this file only holds placeholders.

# Required: embeddings always go through Gemini, regardless of LLM_PROVIDER below.
GEMINI_API_KEY=<your-gemini-api-key>

# Optional: which provider handles text generation (extraction/consolidation/
# query synthesis). Defaults to "gemini" if unset. Set to "concentrate" to use
# Concentrate AI instead (e.g. if you run out of Gemini credit) — in that case
# CONCENTRATE_AI_API_KEY below becomes required.
LLM_PROVIDER=gemini

# Optional: only required if LLM_PROVIDER=concentrate.
CONCENTRATE_AI_API_KEY=<your-concentrate-ai-api-key>

# Optional: only required if you're ingesting from Notion.
NOTION_API_KEY=<your-notion-integration-token>

# FalkorDB connection — matches the `docker run -p 6380:6379 ...` command in
# the README. Change these only if you mapped a different host port.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
