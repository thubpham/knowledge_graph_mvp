# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — this file only holds placeholders.

# Required only if EMBEDDING_PROVIDER below is "gemini" (the default), or if
# some generation provider above/below is set to "gemini".
GEMINI_API_KEY=<your-gemini-api-key>

# Optional: fallback/default provider for any LLMClient() built without an
# explicit provider (ad-hoc scripts, notebooks). Defaults to "gemini" if
# unset. The task-specific env vars below take priority for the pipelines
# that actually run in production (ingest/consolidation/query/resolver/dedup)
# — see llm_clients.py and IMPROVEMENTS.md's Provider Routing section for the
# full per-task model assignment and rationale.
LLM_PROVIDER=gemini

# Optional: only required if some provider above/below is set to "concentrate".
CONCENTRATE_AI_API_KEY=<your-concentrate-ai-api-key>

# Optional: only required if some provider above/below is set to "anthropic".
# Get a key at console.anthropic.com. Structured outputs (output_config.format)
# are natively schema-enforced, same guarantee as Gemini's response_schema —
# see llm_clients.py's _NATIVE_SCHEMA_PROVIDERS.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# claude-haiku-4-5: cheapest current model, structured-outputs-capable, and a
# good fit for extraction's high call volume / moderate per-call accuracy
# bar. Override to claude-sonnet-5 for lower-volume, accuracy-sensitive tasks
# (consolidation/query) via this same var — see model-migration guidance for
# exact model ID strings; never hand-construct one.
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional: only required if some provider above/below is set to "groq". Get
# a free key at console.groq.com -> API Keys. Groq's free tier is far more
# generous than Gemini's (20 generateContent calls/day), which is why it's
# the default for extraction/consolidation/query below.
GROQ_API_KEY=<your-groq-api-key>
# openai/gpt-oss-120b, not llama-3.3-70b-versatile: Groq only supports strict
# json_schema structured outputs (what llm_clients.py's _GroqProvider sends)
# on its gpt-oss models — llama-3.3-70b-versatile 400s on every call. 120b
# (not the smaller 20b) chosen to stay close to the accuracy bar the 70b
# dense model this replaces was picked for — 120b is a MoE model (~5.1B
# active params/token vs 20b's ~3.6B), still cheap on Groq's pricing. See
# https://console.groq.com/docs/structured-outputs#supported-models.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: only required if some provider above/below is set to "ollama".
# Requires Ollama running locally (default http://localhost:11434) with the
# model pulled: `ollama pull llama3.1:8b`. No API key, no rate limit — used
# for the resolver/dedup entity-match confirmation tier by default, since
# that's high call volume but low individual stakes (a wrong local call just
# falls back to "no match").
OLLAMA_MODEL=llama3.1:8b

# Optional: only required if some provider above/below is set to "openrouter".
# Get a key at openrouter.ai/keys — set a spend limit on it there, separate
# from this file. Every prompt template is split into a static system half
# and a dynamic user half (see prompts.py) specifically so OpenRouter's
# provider-side prompt caching can key on the system half being
# byte-identical call over call — see llm_clients.py's _OpenRouterProvider
# for the sticky-routing (`session_id`) and provider-selection
# (`sort`/`require_parameters`) mechanics that make that caching actually
# land on the same upstream provider. Before routing any task to
# "openrouter" (via the *_LLM_PROVIDER vars below), confirm on OpenRouter's
# model page that the model you're about to set here supports structured
# outputs, and check its current input/output price against your first
# invoice — no code guards against a provider silently substituting a
# pricier or non-structured-output-capable upstream.
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Embedding provider, independent of every generation provider above: "gemini"
# (default, for backward compatibility) or "ollama". Gemini's free tier caps
# at 1000 embed requests/day, which a full ingest blows through in minutes
# once resolve_entity starts embedding most extracted entities (see
# resolver.py's tier comments) — "ollama" removes that ceiling entirely, at
# the cost of needing Ollama running locally with the model pulled:
# `ollama pull nomic-embed-text`. Its 768-dim output matches core.graph's
# vector index exactly, so switching doesn't require an index migration —
# but it DOES require re-embedding (or wiping) every node embedded under the
# other provider, since cosine distance between vectors from two different
# embedding models is meaningless.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: per-task provider overrides — these are the actual source of
# truth for ingest/consolidation/query/resolver/dedup; there's no hardcoded
# fallback for any of them in code anymore. If a var below is unset, that
# task's LLMClient falls through to LLM_PROVIDER above, then to "gemini".
# The values below are the recommended assignment (see llm_clients.py and
# IMPROVEMENTS.md's Provider Routing section for the full rationale), not a
# code-level default — set whatever you actually want each task to use.
# (EMBEDDING_PROVIDER above applies to all of these uniformly — there's no
# per-task embedding override, since every task that embeds shares one
# vector index and mixing embedding models within it would corrupt it.)
EXTRACTION_LLM_PROVIDER=anthropic
RESOLVER_LLM_PROVIDER=anthropic
CONSOLIDATION_LLM_PROVIDER=groq
DEDUP_LLM_PROVIDER=ollama
QUERY_LLM_PROVIDER=groq

# Optional: only required if you're ingesting from Notion.
NOTION_API_KEY=<your-notion-integration-token>

# FalkorDB connection — matches the `docker run -p 6380:6379 ...` command in
# the README. Change these only if you mapped a different host port.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
